# Copy to .env

# --- AI Provider Configuration ---
# Google Gemini:
GEMINI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-3.5-flash-lite
# Tried when the main model is overloaded or unavailable (optional):
AI_FALLBACK_MODEL=gemini-3.5-flash

# Or Anthropic Claude:
# ANTHROPIC_API_KEY=your-anthropic-api-key
# AI_MODEL=claude-sonnet-5-5

# Optional. Login tokens are signed with a key that is generated once and saved in backend/storage.
# Set SECRET_KEY to use your own (needed if you run several backend copies).
# SECRET_KEY=

# Set to true to try the app WITHOUT an API key (returns a sample architecture).
# DEMO_MODE=false

# SQLite file location (defaults to backend/storage/sysdesign.db)
# DB_PATH=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
